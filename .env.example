# Copy this file to .env and change the values.
# .env is gitignored — never commit real secrets.

# Port the API listens on (server.js falls back to 3000)
PORT=3000

# Signing key for the admin JWTs (middleware/auth.js).
# MUST be changed before deploying — the fallback is a public default.
JWT_SECRET=super-secret-change-me
